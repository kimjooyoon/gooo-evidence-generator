namespace evidencegenerator "gooo://evidence-generator/self-hosted/v1"

entity ReleasedGoooIdentity "gooo://evidence-generator/entity/released-gooo"
entity PatternObservation "gooo://evidence-generator/entity/pattern-observation"
entity PromotionPolicy "gooo://evidence-generator/entity/promotion-policy"
entity GeneratedProjectAuthority "gooo://evidence-generator/entity/project-authority"
entity GeneratedDenominator "gooo://evidence-generator/entity/generated-denominator"
entity GeneratedActivityBindings "gooo://evidence-generator/entity/activity-bindings"
entity GeneratedConformancePlan "gooo://evidence-generator/entity/conformance-plan"
entity GenerationReceipt "gooo://evidence-generator/entity/generation-receipt"
entity ReplayObservation "gooo://evidence-generator/entity/replay-observation"
entity ReadOnlyObservation "gooo://evidence-generator/entity/read-only-observation"
entity UnknownTrace "gooo://evidence-generator/entity/unknown-trace"
entity RefutationTrace "gooo://evidence-generator/entity/refutation-trace"
entity EvidenceDecision "gooo://evidence-generator/entity/evidence-decision"

activity ObserveReleasedGoooIdentity(ReleasedGoooIdentity) -> EvidenceDecision
activity ObservePatternSupport(PatternObservation) -> EvidenceDecision
activity ApplyPromotionThreshold(PromotionPolicy) -> EvidenceDecision
activity DeclareGeneratedProjectAuthority(GeneratedProjectAuthority) -> EvidenceDecision
activity GenerateDenominator(GeneratedDenominator) -> EvidenceDecision
activity BindGeneratedActivities(GeneratedActivityBindings) -> EvidenceDecision
activity GenerateConformancePlan(GeneratedConformancePlan) -> EvidenceDecision
activity PublishGenerationReceipt(GenerationReceipt) -> EvidenceDecision
activity ObserveDeterministicReplay(ReplayObservation) -> EvidenceDecision
activity ObserveZeroSourceWrite(ReadOnlyObservation) -> EvidenceDecision
activity PreserveUnknownTrace(UnknownTrace) -> EvidenceDecision
activity PreserveRefutationTrace(RefutationTrace) -> EvidenceDecision
